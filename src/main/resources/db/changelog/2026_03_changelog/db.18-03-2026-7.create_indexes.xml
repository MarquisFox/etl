<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create-indexes" author="marquis">
        <createIndex indexName="idx_customers_updated" tableName="customers">
            <column name="updated_at"/>
        </createIndex>
        <createIndex indexName="idx_orders_updated" tableName="orders">
            <column name="updated_at"/>
        </createIndex>
        <createIndex indexName="idx_products_updated" tableName="products">
            <column name="updated_at"/>
        </createIndex>
        <createIndex indexName="idx_order_items_updated" tableName="order_items">
            <column name="updated_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>