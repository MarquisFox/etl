<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create-sync-state-table" author="etl">
        <createTable tableName="sync_state">
            <column name="id" type="INT" defaultValue="1">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_sync" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="sync_state">
            <column name="id" value="1"/>
            <column name="last_sync" valueDate="2026-01-01T00:00:00"/>
        </insert>
    </changeSet>
</databaseChangeLog>